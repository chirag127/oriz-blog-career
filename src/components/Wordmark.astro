---
/*
 * Wordmark — "Vitals" set in Fraunces with a live coral heartbeat glyph
 * before the name. The pulse tick is the brand mark: a single ECG spike
 * (the QRS complex) that reads as "monitored, alive, calm". Health-native,
 * not the oriz z-strike (that anchors the sister sites; this site owns its
 * own mark per the design-diversity rule).
 */

interface Props {
  /** Sub-section name — rendered after a `/` separator. */
  subtitle?: string
  /** Display size in CSS pixels. */
  size?: number
  /** Wrap the mark in an <a href="/"> — defaults to '/' when subtitle is set. */
  href?: string | null
  /** Render as <h1> (the masthead) rather than <div>. */
  asHeading?: boolean
}

const { subtitle, size = 96, href = null, asHeading = false } = Astro.props
const Tag = asHeading ? 'h1' : ('div' as const)
---

{
  href ? (
    <a class="wordmark-link" href={href} aria-label={subtitle ? `Vitals / ${subtitle}` : 'Vitals'}>
      <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
        <svg class="wordmark-pulse" viewBox="0 0 40 24" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
          <path d="M1 12 H11 L14 12 L16 4 L19 20 L22 8 L24 12 H39" />
        </svg>
        <span class="wordmark-name">Vitals</span>
        {subtitle && (
          <>
            <span class="wordmark-sep" aria-hidden="true">/</span>
            <span class="wordmark-sub">{subtitle}</span>
          </>
        )}
      </Tag>
    </a>
  ) : (
    <Tag class="wordmark" style={`--wm-size: ${size}px;`}>
      <svg class="wordmark-pulse" viewBox="0 0 40 24" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
        <path d="M1 12 H11 L14 12 L16 4 L19 20 L22 8 L24 12 H39" />
      </svg>
      <span class="wordmark-name">Vitals</span>
      {subtitle && (
        <>
          <span class="wordmark-sep" aria-hidden="true">/</span>
          <span class="wordmark-sub">{subtitle}</span>
        </>
      )}
    </Tag>
  )
}

<style>
  .wordmark-link {
    display: inline-block;
    color: inherit;
    text-decoration: none;
  }
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.32em;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--wm-size, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .wordmark-pulse {
    align-self: center;
    width: 1.25em;
    height: 0.75em;
    overflow: visible;
    flex: 0 0 auto;
  }
  .wordmark-pulse path {
    fill: none;
    stroke: var(--pulse);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .wordmark-name {
    font-optical-sizing: auto;
  }
  .wordmark-sep {
    margin-inline: 0.12em;
    color: var(--ink-mute);
    font-weight: 400;
  }
  .wordmark-sub {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.62em;
    letter-spacing: 0.04em;
  }
  /* calm heartbeat — a single slow pulse of the QRS spike */
  @media (prefers-reduced-motion: no-preference) {
    .wordmark-link:hover .wordmark-pulse path,
    .wordmark:hover .wordmark-pulse path {
      animation: wm-beat var(--dur-slow, 440ms) var(--ease-out) 1;
    }
    @keyframes wm-beat {
      0% { stroke-dasharray: 0 120; }
      100% { stroke-dasharray: 120 0; }
    }
  }
</style>
