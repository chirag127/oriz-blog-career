---
/*
 * Footer — "end of signal" monitor strip.
 *
 * Not a 4-column magazine sitemap. A single low bar that reads like the tail
 * of a monitor trace: a flatlining ECG rule, one calm sign-off line, and an
 * inline row of links set in mono. The rail already carries navigation, so
 * the footer stays quiet — one voice (the sign-off), everything else hairline.
 */
import EcgTrace from '~/components/EcgTrace.astro'
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { getCategoriesWithCounts, slugifyTag } from '~/lib/blog'

const topics = (await getCategoriesWithCounts()).slice(0, 8).map(({ category }) => ({
  name: category,
  slug: slugifyTag(category),
}))
---
<footer class="blog-footer" role="contentinfo">
  <div class="bf-flatline" aria-hidden="true">
    <EcgTrace variant="rule" />
  </div>
  <div class="bf-inner">
    <p class="bf-signoff">Small changes, measured. No hype, no miracle fixes.</p>
    <nav class="bf-links" aria-label="Footer">
      <a href="/">Feed</a>
      <a href="/series/">Programs</a>
      <a href="/tags/">Markers</a>
      <a href="/now/">Status</a>
      <a href="/archive/">Log</a>
      <a href="/about/">Profile</a>
    </nav>
    {topics.length > 0 && (
      <p class="bf-topics">
        {topics.map((t, i) => (
          <>
            {i > 0 && <span class="bf-topic-sep" aria-hidden="true">·</span>}
            <a href={`/categories/${t.slug}/`}>{t.name}</a>
          </>
        ))}
      </p>
    )}
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-health"
    appName="Vitals"
    bio="A calm, evidence-minded health blog on sleep, training, and wellbeing by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .blog-footer {
    margin-top: 5rem;
    background: var(--color-paper-2, var(--paper-2, transparent));
    color: var(--color-ink, var(--ink));
    border-top: 1px solid var(--color-rule, var(--rule));
  }
  .bf-flatline { max-width: 1200px; margin: 0 auto; padding: 20px 16px 0; opacity: 0.5; }
  .bf-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 16px 24px;
    display: grid;
    gap: 18px;
  }
  .bf-signoff {
    margin: 0;
    font-family: var(--font-display, 'Source Serif 4', Georgia, serif);
    font-weight: 600;
    font-size: clamp(20px, 3vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--color-ink, var(--ink));
    max-width: 42ch;
  }
  .bf-signoff::before {
    content: '“';
    color: var(--color-accent, var(--pulse, #e5605e));
    margin-right: 2px;
  }
  .bf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--font-mono, ui-monospace);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .bf-links a { color: var(--color-ink, var(--ink)); text-decoration: none; border-bottom: 1px solid transparent; }
  .bf-links a:hover { color: var(--color-accent, var(--accent)); border-bottom-color: var(--color-accent, var(--accent)); }
  .bf-topics { margin: 0; line-height: 1.9; }
  .bf-topics a {
    font-family: var(--font-mono, ui-monospace);
    font-size: 12px;
    color: var(--color-ink-mute, var(--ink-mute));
    text-decoration: none;
  }
  .bf-topics a:hover { color: var(--color-accent, var(--accent)); }
  .bf-topic-sep { color: var(--color-rule, var(--rule)); margin-inline: 8px; }
  @media (min-width: 768px) {
    .bf-inner { padding: 20px 24px 28px; grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
    .bf-signoff { grid-row: span 2; }
    .bf-links { justify-content: flex-end; }
    .bf-topics { grid-column: 2; text-align: right; max-width: 40ch; }
    .bf-flatline { padding: 24px 24px 0; }
  }
</style>

