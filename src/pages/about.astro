---
import BaseLayout from '~/layouts/BaseLayout.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chirag Singhal',
  url: 'https://oriz.in/about/',
  jobTitle: 'Software Engineer',
  description:
    'Software engineer specializing in scalable backend architectures, full-stack development, AI agents, and cloud-native deployments.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bhubaneswar',
    addressRegion: 'Odisha',
    addressCountry: 'IN',
  },
  sameAs: [
    'https://github.com/chirag127',
    'https://x.com/chirag127',
    'https://linkedin.com/in/chirag127',
  ],
}
---

<BaseLayout
  title="About — Vitals"
  description="About Vitals — a calm, evidence-minded health and fitness blog by Chirag Singhal."
  jsonLd={jsonLd}
  hideSidebar={true}
>
  <header class="page-head">
    <p class="eyebrow"><a href="/">Vitals</a> / About</p>
    <h1>About</h1>
  </header>

  <article class="prose">
    <p class="lede">
      Vitals is a calm, evidence-minded health and fitness blog — notes on
      sleep, training, stress, and the everyday habits that actually move the
      needle. Plain, specific, no hype.
    </p>

    <h2>What this blog is</h2>
    <p>
      Practical writing on sleep, strength training, stress, and general
      wellbeing — the handful of things with real evidence behind them, tested
      against real weeks. The aim is trustworthy and unhurried: what the
      research supports, what it doesn't, and where the honest uncertainty is.
      No miracle fixes, no supplements to sell, no fear-mongering.
    </p>

    <h2>What this blog is not</h2>
    <p>
      It is <strong>not medical advice</strong>. Nothing here replaces a
      qualified professional who knows your history. For anything that persists,
      worsens, or worries you — see a doctor. See the full
      <a href="/legal/disclaimer/">disclaimer</a>.
    </p>

    <h2>Who writes it</h2>
    <p>
      Chirag Singhal — someone who reads the research and tries the habits
      before writing them up. Part of the
      <a href="https://oriz.in">oriz</a> family of small, free, quiet sites: no
      newsletters you didn't ask for, no popups, no paid tier.
    </p>

    <h2>Contact</h2>
    <p>
      Email: <a href="mailto:whyiswhen@gmail.com">whyiswhen@gmail.com</a>.
      Or use the <a href="/contact/">contact form</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .page-head { padding-block: 3rem 1.5rem; border-bottom: 1px solid var(--color-border); max-width: var(--container-prose, 720px); margin-inline: auto; }
  .eyebrow { color: var(--color-fg-muted); font-size: 0.8125rem; margin: 0 0 0.5rem; }
  .eyebrow a { color: var(--color-fg-muted); text-decoration: none; }
  .eyebrow a:hover { color: var(--color-fg); }
  h1 { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 600; letter-spacing: -0.02em; margin: 0; }
  .prose { padding-block: 2.5rem 4rem; color: var(--color-prose); line-height: 1.75; font-size: 1.0625rem; max-width: var(--container-prose, 720px); margin-inline: auto; }
  .prose .lede { font-size: 1.1875rem; color: var(--color-fg); margin: 0 0 2rem; }
  .prose h2 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; color: var(--color-fg); margin: 2.5rem 0 1rem; }
  .prose p { margin: 0 0 1.25rem; }
  .prose a { color: var(--color-accent); }
</style>
